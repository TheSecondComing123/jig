?start: _NL? [stmt (_NL stmt)* _NL?] -> program

?stmt: NAME ":=" expr -> declare
     | NAME "=" expr -> assign
     | NAME AUGOP expr -> augset
     | "say" expr -> say
     | expr

?expr: or_
     | "if" expr "then" expr ["else" expr] -> if_then
     | "while" expr block -> while_block
     | "loop" block -> while_block
     | "break" -> break_
     | "next" -> next_

block: "{" _NL? [stmt (_NL stmt)* _NL?] "}"

?or_: and_
    | or_ "or" and_ -> or_op

?and_: not_
     | and_ "and" not_ -> and_op

?not_: cmp
     | "not" not_ -> not_op

?cmp: sum
   | sum (CMP sum)+ -> compare

?sum: product
    | sum ADD product -> binary

?product: power
        | product MUL power -> binary

?power: atom
      | atom POW power -> binary
      | ADD power -> unary

?atom: NUMBER -> num
     | NAME -> name
     | "(" expr ")"
     | block

AUGOP: /(\+|-|\*|\/\/|\/|%|\^)=/
CMP: "==" | "!=" | "<=" | ">=" | "<" | ">"
ADD: "+" | "-"
MUL: "*" | "//" | "/" | "%"
POW: "^"

NUMBER: /\d[\d_]*/
NAME: /[A-Za-z_]\w*/
_NL: /(;|\n)([ \t\r]*(;|\n))*/

%ignore /[ \t\r]+/
